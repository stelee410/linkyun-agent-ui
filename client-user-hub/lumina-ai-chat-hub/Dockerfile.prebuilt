# 使用本地或 CI 已构建好的 dist，不再在容器内执行 npm run build。
# 用法：先在本机执行 npm run build，再构建镜像：
#   npm run build
#   docker build -f Dockerfile.prebuilt -t lumina-ai-chat-hub .
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
